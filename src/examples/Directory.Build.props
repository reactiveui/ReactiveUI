<Project>
  <PropertyGroup>
    <!-- Projects in this folder (examples) are not shipped libraries, so they have no public
         API surface to track. Disabling here (rather than by path-substring matching in the
         root props) avoids false positives from unrelated paths. This has to precede the import:
         the root defaults the value and derives $(EnablePublicApiBaseline) and the analyzer
         reference from it, so setting it afterwards leaves tracking half on. -->
    <TrackPublicApi>false</TrackPublicApi>
  </PropertyGroup>

  <!-- Inherit all repository-wide settings from the root src/Directory.Build.props. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />
</Project>
