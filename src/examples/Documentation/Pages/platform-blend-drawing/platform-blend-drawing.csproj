<Project Sdk="Microsoft.NET.Sdk">

  <!-- The drawing example hosts WPF controls on Windows. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>$(ReactiveUIWindowsTargets)</TargetFrameworks>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWPF>true</UseWPF>
    <PublishAot>false</PublishAot>
    <IsAotCompatible>false</IsAotCompatible>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    <EnableSingleFileAnalyzer>false</EnableSingleFileAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <!-- ReactiveUI.Wpf gives the app a real dispatcher-backed main-thread scheduler (WithWpf), which
         FollowObservableStateBehavior and ObservableTrigger need to deliver onto the UI thread. -->
    <ProjectReference Include="../../../../ReactiveUI.Wpf/ReactiveUI.Wpf.csproj" />
    <ProjectReference Include="../../../../ReactiveUI.Blend/ReactiveUI.Blend.csproj" />
    <ProjectReference Include="../../../../ReactiveUI.Drawing/ReactiveUI.Drawing.csproj" />
  </ItemGroup>

</Project>
