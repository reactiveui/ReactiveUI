<Project Sdk="Microsoft.NET.Sdk">

  <!-- WPF uses the Windows desktop targets and runs on Windows. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>$(ReactiveUIWindowsTargets)</TargetFrameworks>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWPF>true</UseWPF>
    <PublishAot>false</PublishAot>
    <IsAotCompatible>false</IsAotCompatible>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    <EnableSingleFileAnalyzer>false</EnableSingleFileAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../../../ReactiveUI.Wpf/ReactiveUI.Wpf.csproj" />
    <ProjectReference Include="../../../../ReactiveUI.Wpf.Unsafe/ReactiveUI.Wpf.Unsafe.csproj" />
  </ItemGroup>

</Project>
