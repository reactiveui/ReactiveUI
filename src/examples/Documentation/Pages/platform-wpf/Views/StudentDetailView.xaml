<reactiveui:ReactiveUserControl
    x:Class="ReactiveUI.Documentation.PlatformWpf.StudentDetailView"
    x:TypeArguments="local:StudentDetailViewModel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:reactiveui="http://reactiveui.net"
    xmlns:local="clr-namespace:ReactiveUI.Documentation.PlatformWpf">

    <StackPanel Margin="24" Width="240">
        <TextBlock x:Name="NameText" FontSize="18" Margin="0,0,0,16" />

        <TextBlock Text="Grade" Margin="0,0,0,4" />
        <TextBox x:Name="GradeBox" Margin="0,0,0,16" />

        <Button x:Name="BackButton" Content="Save and go back" />
    </StackPanel>

</reactiveui:ReactiveUserControl>
