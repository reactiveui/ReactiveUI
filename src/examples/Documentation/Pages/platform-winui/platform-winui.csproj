<Project Sdk="Microsoft.NET.Sdk">

  <!-- ReactiveUI.WinUI is a Windows-only library. Directory.Build.props targets plain net10.0 and publishes as
       NativeAOT, neither of which fits a WinUI app, so both are overridden here. EnableWindowsTargeting (set
       repository-wide) lets this project build on Linux; it only ever runs on Windows. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWinUI>true</UseWinUI>
    <PublishAot>false</PublishAot>
    <IsAotCompatible>false</IsAotCompatible>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    <EnableSingleFileAnalyzer>false</EnableSingleFileAnalyzer>
    <WindowsSdkPackageVersion>10.0.19041.48</WindowsSdkPackageVersion>

    <!-- Unpackaged desktop app: no MSIX. Framework-dependent (not self-contained) unpackaged Windows App SDK,
         so it runs against the Windows App Runtime already installed on the machine, resolved at startup by
         Program's own Bootstrap.TryInitialize call rather than the SDK's automatic module initializer (see
         Program.cs for why). -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <WindowsAppSdkBootstrapInitialize>false</WindowsAppSdkBootstrapInitialize>
    <WindowsAppSdkIncludeVersionInfo>true</WindowsAppSdkIncludeVersionInfo>
    <GenerateAppxPackageOnBuild>false</GenerateAppxPackageOnBuild>
    <PublishAppxPackage>false</PublishAppxPackage>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <ProjectReference Include="../../../../ReactiveUI.WinUI/ReactiveUI.WinUI.csproj" />
  </ItemGroup>

</Project>
