<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(ReactiveUITestingTargets)</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <FodyTargetFramework>netstandard2.0</FodyTargetFramework>
    <FodyTargetFramework Condition=" $(TargetFramework.StartsWith('net4')) ">$(TargetFramework)</FodyTargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ReactiveUI.Test.Utilities\ReactiveUI.Test.Utilities.csproj"/>
    <ProjectReference Include="..\..\ReactiveUI.Testing\ReactiveUI.Testing.csproj"/>
    <ProjectReference Include="..\..\ReactiveUI.Testing.Reactive\ReactiveUI.Testing.Reactive.csproj" Aliases="reactive_testing" />
  </ItemGroup>

  <!-- This test assembly compiles lean source while referencing the Reactive assembly through an alias.
       Keep the lean Binding generator; the Reactive package's generator would emit duplicate members. -->
  <Target Name="StripReactiveBindingAnalyzers" BeforeTargets="CoreCompile">
    <ItemGroup>
      <Analyzer Remove="@(Analyzer)" Condition="$([System.String]::Copy('%(Analyzer.FullPath)').Contains('reactiveui.binding.reactive'))"/>
    </ItemGroup>
  </Target>

  <ItemGroup>
    <None Include="API\**\*.txt" CopyToOutputDirectory="PreserveNewest" LinkBase="/"/>
  </ItemGroup>

  <ItemGroup>
    <Using Include="ReactiveUI.Primitives" />
    <Using Include="ReactiveUI.Primitives.Advanced" />
    <Using Include="ReactiveUI.Primitives.Signals" />
  </ItemGroup>

</Project>
