<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(ReactiveUITestingUITargets)</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>ReactiveUI.Tests</RootNamespace>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ReactiveUI.Test.Utilities\ReactiveUI.Test.Utilities.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="**\*.cs"/>
    <None Include="**\*.cs"/>
    <Compile Include="API\**\*.cs"/>
  </ItemGroup>

  <Choose>
    <When Condition=" $(TargetFramework.EndsWith('-windows10.0.19041.0')) ">
      <PropertyGroup>
        <UseWinUI>true</UseWinUI>
        <DefineConstants>$(DefineConstants);IS_WINUI;WINUI_TARGET</DefineConstants>
        <WindowsPackageType>None</WindowsPackageType>
        <!-- Carry the runtime from the referenced SDK so CI runs against that exact version. -->
        <WindowsAppSDKSelfContained Condition="'$(OS)' == 'Windows_NT'">true</WindowsAppSDKSelfContained>
        <WindowsAppSDKSelfContained Condition="'$(OS)' != 'Windows_NT'">false</WindowsAppSDKSelfContained>
        <GenerateAppxPackageOnBuild>false</GenerateAppxPackageOnBuild>
        <PublishAppxPackage>false</PublishAppxPackage>
        <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
        <WindowsSdkPackageVersion>10.0.19041.48</WindowsSdkPackageVersion>
        <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
        <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
      </PropertyGroup>
      <ItemGroup>
        <PackageReference Include="Microsoft.WindowsAppSDK"/>
        <PackageReference Include="Microsoft.Windows.SDK.BuildTools"/>
        <ProjectReference Include="..\..\ReactiveUI.WinUI\ReactiveUI.WinUI.csproj"/>
        <Using Include="ReactiveUI.Builder"/>
        <Compile Include="WinUI\**\*.cs"/>
        <Compile Include="AssemblyHooks.cs"/>
        <Compile Include="AssemblyInfo.Parallel.cs"/>
      </ItemGroup>
    </When>
  </Choose>

  <!-- Off-Windows the WinUI MSIX/PRI pipeline (MakePri.exe) and the CsWinRT projection cannot run; the managed
       assembly still compiles so the Linux/macOS CI legs validate this project. -->
  <Import Project="..\..\ReactiveUI.WinUI\build\SkipMakePriOnNonWindows.targets"
          Condition="!$([MSBuild]::IsOsPlatform('Windows'))"/>
</Project>
