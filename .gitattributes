# Auto-detect text files and use LF in both the repository and working tree.
* text=auto eol=lf

# Source code
*.cs       text diff=csharp
*.xaml     text
*.slnx     text
*.sln      text eol=lf
*.csproj   text
*.props    text
*.targets  text
*.json     text
*.xml      text
*.yml      text
*.yaml     text
*.md       text
*.txt      text
*.sh       text eol=lf
*.ps1      text
*.cmd      text eol=lf
*.bat      text eol=lf
*.config   text
*.editorconfig text

# Binary files (do not normalise or diff)
*.png      binary
*.jpg      binary
*.gif      binary
*.ico      binary
*.pfx      binary
*.snk      binary

# Binary content that no other rule covers.
*.7z       binary
*.bmp      binary
*.dll      binary
*.exe      binary
*.gz       binary
*.lib      binary
*.otf      binary
*.pdb      binary
*.pdf      binary
*.psd      binary
*.so       binary
*.tar      binary
*.ttf      binary
*.webp     binary
*.winmd    binary
*.woff     binary
*.woff2    binary
*.zip      binary
